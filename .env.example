# N8N_WEBHOOK_URL: Webhook URL for NEXUS AI n8n workflow.
# Default is the production endpoint: https://raphadi.app.n8n.cloud/webhook/nexus-ai
N8N_WEBHOOK_URL="https://raphadi.app.n8n.cloud/webhook/nexus-ai"

# PORT: Server listening port (default: 3000)
PORT=3000

# GEMINI_API_KEY: Optional fallback if configured
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

